# Noise rules: sg-office expired on 2026-10-31, so the security group drift is back and a warning
# names the rule. queue-gone matches the deleted queue, but delete is in never_hide (the default),
# so the queue stays visible. db-class hides one attribute and leaves the sensitive password.
env TEST_NOW=2026-11-12T08:00:00Z
cd $DRIFT/ingest

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format tty
cmp stdout $WORK/golden/drift.txt
stderr 'noise rule "sg-office" is past its expires date'

# With never_hide emptied, the same rule hides the queue.
! exec tfcensus drift --config $WORK/hide-all.yaml --from-json-out-dir plans --report-file report.json --format json
stdout '"rule": "user/queue-gone"'
! stdout '"protected"'

# Rule errors are usage errors, found before any plan is read.
exec expect-exit 2 tfcensus drift --config $WORK/bad.yaml --from-json-out-dir plans
stderr 'drift.noise\[0\]: a preset entry takes no other key'
stderr 'drift.noise\[1\] \(broken\): invalid attribute pattern "ingress\[x\]"'

-- tfcensus.yaml --
schema_version: 1
drift:
  noise:
    - name: sg-office
      type: aws_security_group
      attribute: 'ingress[*].cidr_blocks'
      reason: office VPN range, removed after the move
      expires: "2026-10-31"
    - name: queue-gone
      type: aws_sqs_queue
      reason: queues are recreated by the job runner
    - name: db-class
      address: aws_db_instance.main
      attribute: instance_class
      reason: resized by the on-call runbook
-- hide-all.yaml --
schema_version: 1
drift:
  never_hide: []
  noise:
    - name: queue-gone
      type: aws_sqs_queue
      reason: queues are recreated by the job runner
-- bad.yaml --
schema_version: 1
drift:
  noise:
    - preset: aws-tags-all
      reason: extra
    - name: broken
      attribute: 'ingress[x]'
      reason: bad pattern
