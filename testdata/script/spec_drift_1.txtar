# drift ingest over 12 recorded units: one collapsed group of 3 tag drifts, one failed unit, every
# format. The failed unit makes the exit code 1; --fail-on drift makes it 3.
env TEST_NOW=2026-11-12T08:00:00Z
cd $DRIFT/ingest

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format tty
cmp stdout $WORK/golden/drift.txt
stderr '1 unit\(s\) failed'

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format md
cmp stdout $WORK/golden/drift.md

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format json
jsonschema drift-v1.json stdout
jsonschema report-v1.json stdout
cmp stdout $WORK/golden/drift.json

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format github
cmp stdout $WORK/golden/drift.github

! exec tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --format sarif
sarifschema stdout
cmp stdout $WORK/golden/drift.sarif

exec expect-exit 3 tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --fail-on drift --min-count 6 --format json
stderr 'matched \(drift: 6\)'
exec expect-exit 1 tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --fail-on drift --min-count 7 --format json
exec expect-exit 3 tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --fail-on errors --format json
exec expect-exit 2 tfcensus drift --config $WORK/tfcensus.yaml --from-json-out-dir plans --report-file report.json --fail-on drift:reverts
stderr 'needs --mode full'

-- tfcensus.yaml --
schema_version: 1
drift:
  noise:
    - preset: aws-tags-all
    - preset: computed-hashes
