# An expired rule stops matching and produces a warning. TEST_NOW injects the clock.
env HOME=$WORK/home

# On the last day the rule applies.
env TEST_NOW=2026-09-30T23:00:00Z
exec tfcensus rules test rules.yaml --resource bucket.json
cmp stdout before.txt
! stderr 'expired'

# The day after, it no longer matches and rules test warns.
env TEST_NOW=2026-10-01T00:00:00Z
exec tfcensus rules test rules.yaml --resource bucket.json
cmp stdout after.txt
stderr 'ownership rule expired.*rule=growth-trial'

-- rules.yaml --
rules:
  - name: growth-trial
    category: ignored
    match: 'resource.tags.?team.orValue("") == "growth"'
    reason: Growth team trial, review after the quarter
    expires: "2026-09-30"
-- bucket.json --
{"account": "111111111111", "region": "eu-west-1", "type": "AWS::S3::Bucket", "tf_types": ["aws_s3_bucket"],
 "arn": "arn:aws:s3:::acme-growth-experiments", "name": "acme-growth-experiments", "tags": {"team": "growth"},
 "layer": "config", "sources": ["config"]}
-- before.txt --
