binaries.terraform                        /opt/bin/tofu                                   flag --tf-path
binaries.terragrunt                       terragrunt                                      default
cache.ttl                                 2h                                              user file $WORK/.config/tfcensus/config.yaml
discovery.generate_stacks                 true                                            env TFCENSUS_DISCOVERY__GENERATE_STACKS
discovery.render                          never                                           project file $WORK/.tfcensus.yaml
discovery.roots                           []                                              default
drift.collapse                            shape                                           default
