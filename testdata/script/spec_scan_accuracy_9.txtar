# The anonymized fixtures of the 13 false-positive groups of the first real-account scan
# (testdata/validation/groups) scan with stubbed AWS and no unmanaged finding.
env TEST_CASSETTE=$CASSETTES/aws/validation
env TEST_NOW=2026-11-16T12:00:00Z
env AWS_CONFIG_FILE=$WORK/aws/config
cd $VALIDATION

exec tfcensus scan repo --config repo/tfcensus.yaml --format json
! stdout '"category": "unmanaged"'
stdout '"unmanaged": 0'

exec tfcensus scan repo --config repo/tfcensus.yaml --format csv
cmp stdout $WORK/golden/validation.csv

-- aws/config --
[default]
region = eu-west-1
aws_access_key_id = AKIAFAKEDEFAULT
aws_secret_access_key = fake-default-secret
