list "aws_iam_role" "tfcensus_global" {
  provider         = aws
  include_resource = true
}

list "aws_iam_user" "tfcensus_global" {
  provider         = aws
  include_resource = true
}

list "aws_s3_bucket" "tfcensus_eu_west_1" {
  provider         = aws
  include_resource = true

  config {
    region = "eu-west-1"
  }
}

list "aws_security_group" "tfcensus_eu_west_1" {
  provider         = aws
  include_resource = true

  config {
    region = "eu-west-1"
  }
}
