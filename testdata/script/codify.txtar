# codify from scan's own JSON report: files, refusal to overwrite, --force, json, and targets.
env TEST_NOW=2026-11-12T23:30:00Z

exec tfcensus codify --from $CODIFY/scan.json --into unit --target terraform@1.14.0 --query
cmp stdout golden/codify.txt
cmp unit/imports_tfcensus_20261112.tf golden/imports.tf
cmp unit/query_tfcensus_20261112.tfquery.hcl golden/query.tfquery.hcl
cmp unit/main.tf main.tf.orig

# A second run refuses before writing; --force writes the same bytes again.
exec expect-exit 2 tfcensus codify --from $CODIFY/scan.json --into unit --target terraform@1.14.0
stderr 'file exists: unit/imports_tfcensus_20261112.tf \(pass --force to overwrite\)'
exec tfcensus codify --from $CODIFY/scan.json --into unit --target terraform@1.14.0 --force --format json
jsonschema codify-v1.json stdout
jsonschema report-v1.json stdout
cmp unit/imports_tfcensus_20261112.tf golden/imports.tf

# OpenTofu before 1.12 imports by id, and has no query.
exec tfcensus codify --from $CODIFY/scan.json --into tofu --target opentofu@1.11.0 --types AWS::IAM::* --query
cmp tofu/imports_tfcensus_20261112.tf golden/tofu.tf
stdout 'note: --query: OpenTofu has no query support yet \(opentofu#3787\): no query file written'
! exists tofu/query_tfcensus_20261112.tfquery.hcl

# --select uses the ownership resource variable; a compile error is a usage error.
exec tfcensus codify --from $CODIFY/scan.json --into sel --target terraform@1.12.0 --select 'resource.tags.?owner.orValue("") == "alice"'
stdout 'Wrote 1 import block'
exec expect-exit 2 tfcensus codify --from $CODIFY/scan.json --into sel --target terraform@1.12.0 --select 'resource.nope' --force
stderr 'rule "--select": column'
exec expect-exit 2 tfcensus codify --from main.tf.orig --into sel
stderr 'read --from'
exec expect-exit 2 tfcensus codify --from $CODIFY/scan.json --into missing
stderr 'not a directory'

-- main.tf.orig --
resource "aws_iam_role" "clickops_admin" {
  name = "clickops-admin-old"
}
-- unit/main.tf --
resource "aws_iam_role" "clickops_admin" {
  name = "clickops-admin-old"
}
-- unit/terragrunt.hcl --
terraform {
  source = "../modules/app"
}
-- tofu/.keep --
-- sel/.keep --
-- golden/codify.txt --
Wrote 5 import block(s) (5 by identity, 0 by id) for terraform 1.14.0 (--target).
  unit/imports_tfcensus_20261112.tf
  unit/query_tfcensus_20261112.tfquery.hcl

note: --query: aws_lb_listener_rule needs list config listener_arn: no list block

Next steps
  cd unit
  terragrunt run -- plan -generate-config-out=$PWD/generated.tf
  or, for config of every resource of the listed types: terragrunt run -- query -generate-config-out=$PWD/generated_query.tf
  review generated.tf, move the resources into your config, then plan until it shows no changes
