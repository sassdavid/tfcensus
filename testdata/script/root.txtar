# Help goes to stdout and lists the M0 commands.
exec tfcensus --help
stdout 'Usage:'
stdout '^  config +Inspect and validate configuration'
stdout '^  version +Print version'
stdout '^  completion '
! stderr .

# Unknown commands and flags are usage errors (exit 2).
exec expect-exit 2 tfcensus nope
stderr 'unknown command "nope"'
stderr 'Run ''tfcensus --help'' for usage'
exec expect-exit 2 tfcensus version --nope
stderr 'unknown flag: --nope'

# Global flag values are validated before any command runs.
exec expect-exit 2 tfcensus version --log-format xml
stderr 'invalid log format "xml"'
exec expect-exit 2 tfcensus version --color sometimes
stderr 'invalid color mode "sometimes"'
exec expect-exit 2 tfcensus version -v -q
stderr 'none of the others can be'

# Logs go to stderr (or --log-file), never stdout.
exec tfcensus -vv version
stdout '^tfcensus '
stderr 'DBG starting command=.tfcensus version.'
exec tfcensus -vv --log-format json --log-file log.json version
! stderr .
grep '"level":"DEBUG","msg":"starting"' log.json
