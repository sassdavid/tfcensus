# scan over a stubbed AWS account and the tf-scan fixture states: every category, every format.
env TEST_CASSETTE=$CASSETTES/aws/scan-fleet
env TEST_NOW=2026-11-10T12:00:00Z
env AWS_CONFIG_FILE=$WORK/aws/config
cd $REPOS

exec tfcensus scan tf-scan --config tf-scan/tfcensus.yaml --format tty
cmp stdout $WORK/golden/scan.txt

exec tfcensus scan tf-scan --config tf-scan/tfcensus.yaml --format md --refresh
cmp stdout $WORK/golden/scan.md

exec tfcensus scan tf-scan --config tf-scan/tfcensus.yaml --format csv --refresh
cmp stdout $WORK/golden/scan.csv

exec tfcensus scan tf-scan --config tf-scan/tfcensus.yaml --format sarif --refresh
sarifschema stdout
cmp stdout $WORK/golden/scan.sarif

exec tfcensus scan tf-scan --config tf-scan/tfcensus.yaml --format json --refresh
jsonschema scan-v1.json stdout
jsonschema report-v1.json stdout
cmp stdout $WORK/golden/scan.json

-- aws/config --
[default]
region = eu-west-1
aws_access_key_id = AKIAFAKEDEFAULT
aws_secret_access_key = fake-default-secret
