-- golden/managed-vpc.txt --
resource  arn:aws:ec2:eu-west-1:111111111111:vpc/vpc-0a1b2c3d4e5f60718
type      AWS::EC2::VPC (aws_vpc)
where     111111111111 eu-west-1
sources   config
match     managed: matched tf-scan/network aws_vpc.main by identity (match/identity)
rules     not evaluated: matching decided
category  managed: matched tf-scan/network aws_vpc.main by identity (match/identity)
