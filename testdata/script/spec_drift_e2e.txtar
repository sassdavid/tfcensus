# L3 drift e2e (docs/plan/testing.md): real terragrunt and $TF with the aws provider against moto.
# Run by TestSpec_drift_e2e once with terraform and once with tofu, each in its own account ($ACCOUNT).
# Both runs compare with the same goldens.
env TEST_NOW=2026-11-16T08:00:00Z

# Apply both units one at a time, so init fills the provider cache without a race.
cd repo/live/app-a
exec terragrunt run --tf-path $TF -- apply -auto-approve -input=false -no-color
cd ../app-b
exec terragrunt run --tf-path $TF -- apply -auto-approve -input=false -no-color
cd $WORK/repo

# Freshly applied units have no drift, so the gate passes.
exec tfcensus drift --tf-path $TF --fail-on drift --format json
jsonschema drift-v1.json stdout
stdout '"groups": 0'

# Someone tags both buckets in the console and opens a port on one security group.
tagbucket tfcensus-drift-${ACCOUNT}-app-a Owner=FIXTURE-SECRET-owner
tagbucket tfcensus-drift-${ACCOUNT}-app-b Owner=FIXTURE-SECRET-owner
openport tfcensus-drift-app-a 22

# Run mode: the tag drift collapses into one group with both units as members. Only paths and
# kinds are printed, never the values.
exec tfcensus drift --tf-path $TF --format json -v
jsonschema drift-v1.json stdout
cmp stdout $WORK/golden/run.json
! stdout FIXTURE-SECRET
stderr 'unit started unit=live/app-a'
stderr 'unit started unit=live/app-b'
! stderr FIXTURE-SECRET
exec tfcensus drift --tf-path $TF --format md
! stdout FIXTURE-SECRET
exec expect-exit 3 tfcensus drift --tf-path $TF --fail-on drift --format json
stderr 'matched \(drift: 3\)'

# Ingest mode reads the plans terragrunt itself wrote and gives the same report. terragrunt exits
# 2 because the plans have changes.
! exec terragrunt run --all --tf-path $TF --json-out-dir $WORK/plans --report-file $WORK/report.json --report-format json --no-color -- plan -refresh-only -lock=false -detailed-exitcode
exec tfcensus drift --from-json-out-dir $WORK/plans --report-file $WORK/report.json --format json
cmp stdout $WORK/golden/run.json

# Full mode: the plan reverts every drift, and the new tag in app-b is a pending change.
cp live/app-b/main.tf.full live/app-b/main.tf
exec tfcensus drift --tf-path $TF --mode full --format json
jsonschema drift-v1.json stdout
cmp stdout $WORK/golden/full.json
exec expect-exit 3 tfcensus drift --tf-path $TF --mode full --fail-on drift:reverts --format json
stderr 'matched \(drift:reverts: 3\)'

