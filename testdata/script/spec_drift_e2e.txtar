-- repo/root.hcl --
locals {
  account_id = read_terragrunt_config(find_in_parent_folders("account.hcl")).locals.id
  endpoint   = get_env("AWS_ENDPOINT_URL")
}

remote_state {
  backend = "s3"
  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }
  config = {
    bucket                  = "tfcensus-e2e-drift-${local.account_id}"
    key                     = "${path_relative_to_include()}/terraform.tfstate"
    region                  = "us-east-1"
    use_lockfile            = true
    use_path_style          = true
    skip_metadata_api_check = true
    assume_role = {
      role_arn = "arn:aws:iam::${local.account_id}:role/tfcensus-e2e"
    }
    endpoints = {
      s3  = local.endpoint
      sts = local.endpoint
    }
  }
}

generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    terraform {
      required_providers {
        aws = {
          source  = "hashicorp/aws"
          version = "= 6.73.0"
        }
      }
    }

    provider "aws" {
      region                      = "us-east-1"
      s3_use_path_style           = true
      skip_credentials_validation = true
      skip_metadata_api_check     = true
      assume_role {
        role_arn = "arn:aws:iam::${local.account_id}:role/tfcensus-e2e"
      }
      endpoints {
        ec2 = "${local.endpoint}"
        s3  = "${local.endpoint}"
        sts = "${local.endpoint}"
      }
    }
  EOF
}

inputs = {
  account_id = local.account_id
  unit       = basename(get_terragrunt_dir())
}
-- repo/live/app-a/terragrunt.hcl --
include "root" {
  path = find_in_parent_folders("root.hcl")
}
-- repo/live/app-b/terragrunt.hcl --
include "root" {
  path = find_in_parent_folders("root.hcl")
}
-- repo/live/app-a/main.tf --
variable "account_id" {
  type = string
}

variable "unit" {
  type = string
}

# moto 5.2.5 drops the tags the aws provider sends with CreateBucket, so the state and the bucket
# start with none.
resource "aws_s3_bucket" "data" {
  bucket = "tfcensus-drift-${var.account_id}-${var.unit}"
  tags = {
    Team = "platform"
  }
}

resource "aws_security_group" "web" {
  name        = "tfcensus-drift-${var.unit}"
  description = "tfcensus drift e2e"
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/8"]
  }
  tags = {
    Team = "platform"
  }
}
-- repo/live/app-b/main.tf.full --
