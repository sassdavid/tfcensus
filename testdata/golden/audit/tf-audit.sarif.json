              "id": "S3-PAB",
              "properties": {
                "severity": "high"
              },
              "shortDescription": {
                "text": "Bucket and account public access block are all on"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Add a Deny for Principal \"*\", Action s3:*, the bucket and bucket/* resources, with Bool aws:SecureTransport false as the only condition."
              },
              "id": "S3-TLS",
              "properties": {
                "severity": "high"
              },
              "shortDescription": {
                "text": "State bucket policy denies requests without TLS"
