      "region": "global",
      "name": "aws-controltower-AdministratorExecutionRole"
    },
    {
      "type": "AWS::IAM::Role",
      "arn": "arn:aws:iam::111111111111:role/acme-state-replication",
      "id": "AROA0VALIDATION00004",
      "region": "global",
      "name": "acme-state-replication"
    },
    {
      "type": "AWS::S3::Bucket",
      "arn": "arn:aws:s3:::acme-state-replica",
      "id": "acme-state-replica",
