{
  "group": "Children of CloudFormation resources: attachments and inline policy of aws-controltower-* roles, the subresources of a state bucket and the inline policy of its replication role (both from a stack)",
  "spec_count": 8,
  "why": "inheritance from the aws-managed Control Tower role and from the other-iac bucket and role a stack lists",
  "config": [
