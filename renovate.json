{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "A security fix ships in a release: fix(deps) also for indirect modules",
    "semanticCommitType": "fix"
  },
  "postUpdateOptions": ["gomodTidy"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "**/vendor/**", "**/examples/**", "**/__tests__/**", "**/test/**", "**/tests/**", "**/__fixtures__/**", "**/testdata/**"],
  "github-actions": {
    "managerFilePatterns": ["/^docs/ci/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "The go directive is a support floor, raised by hand (docs/engineering/version-policy.md)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Only propose module versions that build with the go directive",
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "One PR for all non-major GitHub Actions updates; majors get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One PR for all non-major tool updates in mise.toml; majors get their own PR",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools"
    },
    {
      "description": "One PR for non-major updates of the exact versions in docs/package.json; aube-lock.yml commits docs/aube-lock.yaml on the branch (engineering ADR-0016)",
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs site packages"
    },
    {
      "description": "golangci-lint and its golden config move together (ADR-0008); re-apply the local overrides",
      "groupName": "golangci-lint",
      "matchDepNames": ["golangci-lint", "maratori/golangci-lint-config"]
    },
    {
      "description": "ghcr.io has no release timestamps, so age the renovate-version input by the npm release of the same version",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "overrideDatasource": "npm",
      "overridePackageName": "renovate",
      "pinDigests": false
    },
    {
      "description": "shellcheck releases rarely, but its repository is active",
      "matchDepNames": ["shellcheck"],
      "abandonmentThreshold": null
    },
    {
      "description": "Stable modules from active projects, not abandoned",
      "matchPackageNames": ["github.com/google/go-cmp", "github.com/hashicorp/go-retryablehttp", "github.com/google/go-licenses/v2"],
      "abandonmentThreshold": null
    }
  ],
  "customManagers": [
    {
      "description": "Golden lint config tag in the .golangci.yml header",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.golangci\\.yml$/"],
      "matchStrings": ["# source: maratori/golangci-lint-config (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "maratori/golangci-lint-config",
      "datasourceTemplate": "github-tags"
    }
  ]
}
